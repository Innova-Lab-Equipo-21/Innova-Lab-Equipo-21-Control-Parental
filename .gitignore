# ==============================================================================
# Proyecto: BA Protege+
# Descripción: Archivo de configuración global de Git para exclusión de archivos
# ==============================================================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno y secretos (.env ignorado en la raíz y en subcarpetas)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Firebase Service Accounts (claves privadas)
backend/ba-protege-firebase-adminsdk-*.json
backend/firebase-service-account.json
backend/*firebase-adminsdk*.json

# Compilación y builds
dist/
build/
out/
.next/
*.tsbuildinfo

# Logs y diagnósticos
logs/
*.log

# Entornos de desarrollo y editores (VS Code, Android Studio, IntelliJ)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Android & Gradle (para frontend mobile)
.gradle/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/captures/
frontend/android/.cxx/
*.apk
*.aab
*.keystore
*.jks
keystore.properties
local.properties

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# Documentación interna de trabajo y credenciales locales (no enviar a remoto)
docs/
backend/docs/
