// ==============================================================================
// Proyecto: BA Protege+
// Componente: Base de Datos Relacional (PostgreSQL 18 + Prisma ORM)
// Archivo: schema2.prisma
// Descripción: Schema con formato del backup + tablas QA del db pull
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// ------------------------------------------------------------------------------
// Enum de Género del Usuario Responsable
// ------------------------------------------------------------------------------
enum Gender {
  MASCULINO
  FEMENINO
  OTRO
  NO_INFORMADO

  @@schema("public")
}

// ------------------------------------------------------------------------------
// Enum de Tipo de Protegido (Menor o Adulto)
// ------------------------------------------------------------------------------
enum PersonType {
  MENOR
  ADULTO

  @@schema("public")
}

// ------------------------------------------------------------------------------
// Enum de Estados Efectivos de Protección
// ------------------------------------------------------------------------------
enum ProtectionStatus {
  ACTIVE
  INACTIVE
  STARTING
  ERROR
  PERMISSION_REQUIRED
  SYNC_PENDING
  OUTDATED
  BYPASS_DETECTED
  UNKNOWN

  @@schema("public")
}

// ------------------------------------------------------------------------------
// Enum de Tipo de Lista de Bloqueo
// ------------------------------------------------------------------------------
enum BlocklistType {
  OFFICIAL_LOTBA
  CUSTOM

  @@schema("public")
}

// ------------------------------------------------------------------------------
// Enum de Tipos de Eventos de Seguridad
// ------------------------------------------------------------------------------
enum SecurityEventType {
  VPN_DISABLED
  PERMISSION_REVOKED
  APP_FORCE_STOP
  DEVICE_REBOOT
  NETWORK_CHANGE
  DNS_TAMPERING
  UNINSTALL_ATTEMPT

  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Usuario Responsable
// ------------------------------------------------------------------------------
model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  fullName                String    @map("full_name")
  passwordHash            String    @default("") @map("password_hash")
  gender                  Gender?
  birthDate               DateTime? @map("birth_date") @db.Date
  phone                   String?
  fcmToken                String?   @map("fcm_token")
  isActive                Boolean   @default(true) @map("is_active")
  selfControlActive       Boolean   @default(false) @map("self_control_active")
  selfControlEnabledAt    DateTime? @map("self_control_enabled_at")
  deactivationRequestedAt DateTime? @map("deactivation_requested_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  devices     Device[]
  pairings    DevicePairing[]
  customLists Blocklist[]     @relation("UserCustomLists")
  auditLogs   AuditLog[]

  @@map("users")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Dispositivo Protegido
// ------------------------------------------------------------------------------
model Device {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  deviceName String      @map("device_name")
  deviceUuid String      @unique @map("device_uuid")
  childName  String?     @map("child_name")
  birthDate  DateTime?   @map("birth_date") @db.Date
  gender     Gender?
  personType PersonType? @map("person_type")
  phone      String?
  model      String?
  osVersion  String?     @map("os_version")
  appVersion String?     @map("app_version")
  isActive   Boolean     @default(true) @map("is_active")
  lastSeenAt DateTime?   @map("last_seen_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         DeviceStatus?
  config         ProtectionConfig?
  pairings       DevicePairing[]
  blockedEvents       BlockedEvent[]
  securityEvents      SecurityEvent[]
  pasatiempoSessions  PasatiempoSession[]
  appUsageSnapshots   AppUsageSnapshot[]

  @@map("devices")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Códigos de Pareamiento
// ------------------------------------------------------------------------------
model DevicePairing {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  deviceId    String?     @map("device_id")
  childName   String?     @map("child_name")
  birthDate   DateTime?   @map("birth_date") @db.Date
  gender      Gender?
  personType  PersonType? @map("person_type")
  phone       String?
  pairingCode String      @unique @map("pairing_code")
  isUsed      Boolean     @default(false) @map("is_used")
  expiresAt   DateTime    @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("device_pairings")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Configuración de Protección
// ------------------------------------------------------------------------------
model ProtectionConfig {
  id                   String   @id @default(uuid())
  deviceId             String   @unique @map("device_id")
  protectionEnabled    Boolean  @default(true) @map("protection_enabled")
  blockGambling        Boolean  @default(true) @map("block_gambling")
  blockCustomList      Boolean  @default(true) @map("block_custom_list")
  notifyOnBlock        Boolean  @default(true) @map("notify_on_block")
  notifyOnSecurity     Boolean  @default(true) @map("notify_on_security")
  heartbeatIntervalSec Int      @default(60) @map("heartbeat_interval_sec")
  updatedAt            DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("protection_configs")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Estado Efectivo del Dispositivo
// ------------------------------------------------------------------------------
model DeviceStatus {
  id               String           @id @default(uuid())
  deviceId         String           @unique @map("device_id")
  effectiveStatus  ProtectionStatus @default(UNKNOWN) @map("effective_status")
  vpnActive        Boolean          @default(false) @map("vpn_active")
  permissionsOk    Boolean          @default(true) @map("permissions_ok")
  batteryLevel     Int?             @map("battery_level")
  isCharging       Boolean?         @map("is_charging")
  blocklistVersion Int              @default(1) @map("blocklist_version")
  appVersion       String?          @map("app_version")
  lastHeartbeatAt  DateTime         @default(now()) @map("last_heartbeat_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_status")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Listas de Bloqueo
// ------------------------------------------------------------------------------
model Blocklist {
  id          String        @id @default(uuid())
  userId      String?       @map("user_id")
  name        String
  description String?
  type        BlocklistType @default(OFFICIAL_LOTBA)
  version     Int           @default(1)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user    User?             @relation("UserCustomLists", fields: [userId], references: [id], onDelete: Cascade)
  domains BlocklistDomain[]
  apps    BlocklistApp[]

  @@map("blocklists")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Sitios Permitidos
// ------------------------------------------------------------------------------
model AllowedSite {
  id        String   @id @default(uuid())
  domain    String   @unique @map("domain")
  name      String?  @map("name")
  category  String?  @map("category")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("allowed_sites")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Dominios en Listas de Bloqueo
// ------------------------------------------------------------------------------
model BlocklistDomain {
  id             String   @id @default(uuid())
  blocklistId    String   @map("blocklist_id")
  domain         String
  category       String?  @default("GAMBLING")
  isActive       Boolean  @default(true) @map("is_active")
  applyToAll     Boolean  @default(true) @map("apply_to_all")
  deviceIds      String[] @default([]) @map("device_ids")
  createdBy      String?  @map("created_by")
  createdByName  String?  @map("created_by_name")
  sourceDeviceId String?  @map("source_device_id")
  createdAt      DateTime @default(now()) @map("created_at")

  blocklist Blocklist @relation(fields: [blocklistId], references: [id], onDelete: Cascade)

  @@unique([blocklistId, domain])
  @@map("blocklist_domains")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Aplicaciones en Listas de Bloqueo Personalizadas
// ------------------------------------------------------------------------------
model BlocklistApp {
  id                String   @id @default(uuid())
  blocklistId       String   @map("blocklist_id")
  appName           String   @map("app_name")
  packageName       String   @map("package_name")
  category          String?  @default("Personalizado")
  isActive          Boolean  @default(true) @map("is_active")
  applyToAll        Boolean  @default(true) @map("apply_to_all")
  deviceIds         String[] @default([]) @map("device_ids")
  dailyLimitMinutes Int?     @map("daily_limit_minutes")
  deviceLimits      Json?    @map("device_limits")
  createdBy         String?  @map("created_by")
  createdByName     String?  @map("created_by_name")
  sourceDeviceId    String?  @map("source_device_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  blocklist Blocklist @relation(fields: [blocklistId], references: [id], onDelete: Cascade)

  @@unique([blocklistId, packageName])
  @@map("blocklist_apps")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Eventos de Dominios Bloqueados
// ------------------------------------------------------------------------------
model BlockedEvent {
  id              String   @id @default(uuid())
  deviceId        String   @map("device_id")
  attemptedDomain String   @map("attempted_domain")
  sourceListType  String   @default("LOTBA") @map("source_list_type")
  itemType        String   @default("SITE") @map("item_type")
  blockedAt       DateTime @default(now()) @map("blocked_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, blockedAt])
  @@map("blocked_events")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Eventos de Seguridad
// ------------------------------------------------------------------------------
model SecurityEvent {
  id          String            @id @default(uuid())
  deviceId    String            @map("device_id")
  eventType   SecurityEventType @map("event_type")
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  readAt      DateTime?         @map("read_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, occurredAt])
  @@index([deviceId, readAt])
  @@map("security_events")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Auditoría
// ------------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Sesiones Diarias de Pasatiempos (Quiz, Sopa de Letras, Memoria)
// ------------------------------------------------------------------------------
model PasatiempoSession {
  id           String    @id @default(uuid())
  deviceId     String    @map("device_id")
  dateKey      String    @map("date_key")
  gameType     String    @map("game_type")
  status       String    @default("PENDING")
  correctCount Int       @default(0) @map("correct_count")
  wrongCount   Int       @default(0) @map("wrong_count")
  totalItems   Int       @default(0) @map("total_items")
  attempts     Int       @default(0)
  details      Json?
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, dateKey, gameType])
  @@index([deviceId, dateKey])
  @@map("pasatiempo_sessions")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: Consumo Diario de Aplicaciones Bloqueadas
// ------------------------------------------------------------------------------
model AppUsageSnapshot {
  id                String   @id @default(uuid())
  deviceId          String   @map("device_id")
  dateKey           String   @map("date_key")
  packageName       String   @map("package_name")
  appName           String   @map("app_name")
  usedMinutes       Int      @default(0) @map("used_minutes")
  dailyLimitMinutes Int?     @map("daily_limit_minutes")
  isBlocked         Boolean  @default(false) @map("is_blocked")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, dateKey, packageName])
  @@index([deviceId, dateKey])
  @@map("app_usage_snapshots")
  @@schema("public")
}

// ==============================================================================
// MODELOS QA (convertidos a formato del backup desde schema.prisma introspectado)
// ==============================================================================

// ------------------------------------------------------------------------------
// Modelo: QA Defects
// ------------------------------------------------------------------------------
model QaDefect {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bugId            String?  @unique @map("bug_id")
  bugKey           String?  @unique @map("bug_key")
  title            String
  description      String?
  levelArea        String?  @map("level_area")
  severity         String?
  status           String?
  steps            String?
  actual           String?
  expectedBehavior String?  @map("expected_behavior")
  additionalNotes  String?  @map("additional_notes")
  attachments      Json     @default("[]")
  component        String?
  affectsVersion   String?  @map("affects_version")
  fixVersion       String?  @map("fix_version")
  platform         String?
  reproductionRate String?  @map("reproduction_rate")
  createdBy        String?  @default(dbgenerated("auth.uid()")) @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  qaTestResultId   String?  @map("qa_test_result_id") @db.Uuid

  qaTestResult QaTestResult? @relation(fields: [qaTestResultId], references: [id], onUpdate: NoAction)

  @@index([qaTestResultId], map: "idx_qa_defects_test_result")
  @@map("qa_defects")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Test Cases
// ------------------------------------------------------------------------------
model QaTestCase {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseKey        String    @unique @map("case_key")
  title          String
  module         String?
  testType       String?   @map("test_type")
  priority       String?
  preconditions  String?
  steps          String?
  expectedResult String?   @map("expected_result")
  requirementRef String?   @map("requirement_ref")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  description    String    @default("")
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  categories     String[]  @default([])

  qaTestResults    QaTestResult[]
  qaTestSuiteCases QaTestSuiteCase[]

  @@map("qa_test_cases")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Test Results
// ------------------------------------------------------------------------------
model QaTestResult {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  status       String    @default("Not Run")
  actual       String?
  caseSnapshot Json?     @map("case_snapshot")
  executedBy   String?   @map("executed_by") @db.Uuid
  executedAt   DateTime? @map("executed_at") @db.Timestamptz(6)
  createdBy    String?   @default(dbgenerated("auth.uid()")) @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  comment      String    @default("")

  qaDefects  QaDefect[]
  qaTestCase QaTestCase @relation(fields: [caseId], references: [id], onUpdate: NoAction)
  qaTestRun  QaTestRun  @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("qa_test_results")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Test Runs
// ------------------------------------------------------------------------------
model QaTestRun {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  build       String?
  environment String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  suiteId     String?  @map("suite_id") @db.Uuid

  qaTestResults QaTestResult[]
  qaTestSuite   QaTestSuite?   @relation(fields: [suiteId], references: [id], onUpdate: NoAction)

  @@map("qa_test_runs")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Test Suite Cases
// ------------------------------------------------------------------------------
model QaTestSuiteCase {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suiteId    String    @map("suite_id") @db.Uuid
  testCaseId String    @map("test_case_id") @db.Uuid
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  qaTestSuite QaTestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  qaTestCase  QaTestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([suiteId, testCaseId])
  @@map("qa_test_suite_cases")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Test Suites
// ------------------------------------------------------------------------------
model QaTestSuite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdBy   String?   @default(dbgenerated("auth.uid()")) @map("created_by") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  qaTestRuns       QaTestRun[]
  qaTestSuiteCases QaTestSuiteCase[]

  @@map("qa_test_suites")
  @@schema("public")
}

// ------------------------------------------------------------------------------
// Modelo: QA Workspace Members
// ------------------------------------------------------------------------------
model QaWorkspaceMember {
  userId    String   @id @map("user_id") @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("qa_workspace_members")
  @@schema("public")
}
