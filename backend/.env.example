# ==============================================================================
# Proyecto: BA Protege+
# Componente: Backend API
# Archivo: .env.example
# Descripción: Plantilla de variables de entorno para configuración del servidor, Supabase y Firebase
# ==============================================================================

# Configuración del servidor HTTP
PORT=3000
NODE_ENV=development

# Modo de pruebas sin base de datos (true = usa datos mockeados en memoria, false = usa Supabase PostgreSQL)
USE_MOCK_DATA=false

# Conexión a Supabase mediante Transaction Pooler (PgBouncer en puerto 6543)
DATABASE_URL="postgresql://postgres.[REF_PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa a Supabase (puerto 5432) usada por Prisma para migraciones DDL
DIRECT_URL="postgresql://postgres.[REF_PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clave de API e integración de Firebase
FIREBASE_API_KEY="AIzaSy..."
FIREBASE_PROJECT_ID="ba-protege-d304e"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@ba-protege-d304e.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Seguridad y Autenticación 
FIREBASE_API_KEY="tu_web_api_key_de_firebase_console"

# Configuración de sincronización y telemetría (en minutos)
HEARTBEAT_TIMEOUT_MINUTES=5

# Configuración de correo electrónico vía Brevo HTTPS API (recomendado para Railway, puerto 443)
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="baprotegemas@gmail.com"
BREVO_SENDER_NAME="BA Protege+"

# Fallback local de correo electrónico (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo_gmail@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="BA Protege+" <tu_correo_gmail@gmail.com>