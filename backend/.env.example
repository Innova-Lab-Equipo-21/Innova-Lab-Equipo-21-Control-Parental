# ==============================================================================
# Proyecto: BA Protege+
# Componente: Backend API
# Archivo: .env.example
# Descripción: Plantilla de variables de entorno para configuración del servidor y base de datos
# ==============================================================================

# Configuración del servidor HTTP
PORT=3000
NODE_ENV=development

# Modo de pruebas sin base de datos (true = usa datos mockeados en memoria)
USE_MOCK_DATA=true

# Configuración de base de datos PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baprotege_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET="clave_secreta_super_segura_para_desarrollo_ba_protege"
JWT_EXPIRES_IN="7d"

# Configuración de sincronización y telemetría (en minutos)
HEARTBEAT_TIMEOUT_MINUTES=5
