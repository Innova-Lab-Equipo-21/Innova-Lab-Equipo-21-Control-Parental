{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "/__/auth/action**",
        "destination": "/reset-password.html"
      },
      {
        "source": "/reset-password",
        "destination": "/reset-password.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
