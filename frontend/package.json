{
  "name": "ba-protege-frontend",
  "version": "1.0.0",
  "description": "Aplicación mobile Android (React Native 0.87 + TypeScript + Kotlin) para BA Protege+",
  "homepage": "https://github.com/Innova-Lab-Equipo-21/Innova-Lab-Equipo-21-Control-Parental#readme",
  "license": "ISC",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "build:bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:apk": "cd android && gradlew.bat assembleDebug",
    "install:device": "cd android && gradlew.bat installDebug",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "axios": "^1.7.9",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.87.1",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.72.8",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
