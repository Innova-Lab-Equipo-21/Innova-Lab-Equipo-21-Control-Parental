<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Card Superior Institucional de Identificación -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_blocked_badge"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ BA Protege+"
                    android:textColor="#1D4ED8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mascota Boti / Botito (Ilustración) -->
            <ImageView
                android:id="@+id/ivMascot"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Mascota BA Protege+"
                android:scaleType="fitCenter" />

            <!-- Título Principal -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="¡Momento de cuidar tu tiempo!"
                android:textColor="#0F172A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Card de Mensaje Empático -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_blocked_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Este contenido se encuentra restringido para proteger tu bienestar digital."
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Card de Sugerencias de Actividades Fuera de Pantalla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_blocked_suggestions"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvSuggestionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Ideas para disfrutar fuera de las pantallas:"
                    android:textColor="#0369A1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Salí a caminar o tomar aire fresco.\n• Leé un libro o escuchá tu música favorita.\n• Compartí un momento con tu familia o amigos."
                    android:textColor="#475569"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botones de Acción en la Misma Línea (Padrão App) -->
    <LinearLayout
        android:id="@+id/llActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <!-- Botón Secundario: Seguir navegando (visible para sitios web) -->
        <Button
            android:id="@+id/btnContinueBrowsing"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Seguir navegando"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#0056B3"
            android:background="@drawable/bg_blocked_outline_button"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />

        <!-- Botón Principal: Hacer una pausa -->
        <Button
            android:id="@+id/btnUnderstood"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Hacer una pausa"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_blocked_button"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
