 \xbfQu\xe9 hacer si un sitio leg\xedtimo es bloqueado por error?',answer:'Pod\xe9s reportarlo envi\xe1ndonos un correo con la direcci\xf3n web o aplicaci\xf3n a baprotegemas@gmail.com para que nuestro equipo t\xe9cnico y legal lo eval\xfae y actualice las listas de excepci\xf3n.'},{question:'6. \xbfD\xf3nde puedo solicitar soporte adicional?',answer:'Escribinos en cualquier momento a baprotegemas@gmail.com o comunicate con la l\xednea de atenci\xf3n ciudadana 147 del Gobierno de la Ciudad de Buenos Aires.'}];_e.FaqModal=({visible:e,onClose:s})=>{var n=(0,l.useState)(null),c=(0,o.default)(n,2),u=c[0],p=c[1],y=e=>{p(u===e?null:e)};return(0,i.jsx)(t.Modal,{visible:e,transparent:!0,animationType:"slide",onRequestClose:s,children:(0,i.jsx)(t.TouchableOpacity,{style:_r(d[5]).legalStyles.legalModalOverlay,activeOpacity:1,onPress:s,children:(0,i.jsxs)(t.View,{style:_r(d[5]).legalStyles.legalModalCard,onStartShouldSetResponder:()=>!0,children:[(0,i.jsx)(t.View,{style:_r(d[5]).legalStyles.bottomSheetHandle}),(0,i.jsxs)(t.View,{style:_r(d[5]).legalStyles.legalModalHeader,children:[(0,i.jsx)(t.Text,{style:_r(d[5]).legalStyles.legalModalTitle,children:"Preguntas frecuentes (FAQ)"}),(0,i.jsx)(t.TouchableOpacity,{onPress:s,style:_r(d[5]).legalStyles.legalModalCloseBtn,hitSlop:{top:10,bottom:10,left:10,right:10},children:(0,i.jsx)(t.Text,{style:_r(d[5]).legalStyles.legalModalCloseText,children:"\u2715"})})]}),(0,i.jsx)(t.Text,{style:_r(d[5]).legalStyles.legalModalSubtitle,children:"BA Protege+ \u2022 Centro de Ayuda y Soporte Oficial"}),(0,i.jsxs)(t.ScrollView,{style:_r(d[5]).legalStyles.legalModalBody,showsVerticalScrollIndicator:!0,children:[r.map((e,o)=>{var l=u===o;return(0,i.jsxs)(t.View,{style:{backgroundColor:_r(d[6]).colors.surface,borderRadius:10,padding:12,marginBottom:8,borderWidth:1,borderColor:l?_r(d[6]).colors.primary:_r(d[6]).colors.borderLight},children:[(0,i.jsxs)(t.TouchableOpacity,{onPress:()=>y(o),activeOpacity:.8,style:{flexDirection:'row',justifyContent:'spac